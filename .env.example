# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# --- Needed only for the live voice agent (python -m voice_receptionist.agent dev) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
OPENAI_API_KEY=

# --- App settings (all optional; defaults shown) ---
VR_DB_PATH=data/appointments.db
# VR_BUSINESS_PROFILE_PATH=./my_business.json   # JSON matching config.BusinessProfile; default is sample data
VR_STT_PROVIDER=openai
VR_LLM_PROVIDER=openai
VR_TTS_PROVIDER=openai
VR_LLM_MODEL=gpt-4o-mini

# --- Reserved for the future Twilio integration (not read by any code yet) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
